# WEBSITE OPERATOR ONLY — configure once for all users.
# Copy to .env.web. This file is read only by the web server, never by Expo.
# Reuse an OAuth App you own or register one at https://github.com/settings/developers
# Full guide: ../docs/WEB-AUTH-SETUP.md
# Enable Device Flow on the registration for approval-code sign-in.
# A client secret is optional: when present, auto uses browser redirects.
# Redirect callback: http://127.0.0.1:8082/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# auto: redirect with a secret, approval codes without one; or device / redirect
WEB_AUTH_MODE=auto
WEB_ORIGIN=http://127.0.0.1:8082
# For deployment, use your HTTPS origin and set HOST=0.0.0.0 in the host environment.

# Optional advanced/self-hosted token login. Normal visitors use GitHub sign-in.
WEB_ALLOW_TOKEN_SIGN_IN=false

{
  "expo": {
    "name": "GitGallery",
    "slug": "app",
    "version": "1.3.0",
    "scheme": "gitgallery",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to sync photos to GitHub.",
        "NSPhotoLibraryAddUsageDescription": "This app needs access to save photos to your library.",
        "PHPhotoLibraryPreventAutomaticLimitedAccessAlert": true
      },
      "bundleIdentifier": "com.gitgallery.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:gitgallery-umber.vercel.app"
      ]
    },
    "android": {
      "package": "com.falcon.gitgallery",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B1C1F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gitgallery-umber.vercel.app",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "GitGallery",
      "shortName": "GitGallery",
      "description": "Your photos and videos, in your own GitHub repository.",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo",
            "video"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "xxxx"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-7683902216769416~4263040916"
  }
}
